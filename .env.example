# Copy this file to .env (in the project root) and fill it in. Never commit .env.
# Only needed for deploying to a public test network.

# Private key of your "admin" MetaMask account (test wallet only!).
# It must be the same key as ADMIN_PRIVATE_KEY in voting-backend/.env,
# because whoever deploys the contract owns it.
DEPLOYER_PRIVATE_KEY=

# Free Etherscan API key, for publishing the contract's source code (npm run verify:...).
# Get one at etherscan.io > My Account > API Keys. It works for Basescan too.
ETHERSCAN_API_KEY=

# Optional: your own RPC URLs (e.g. from Alchemy). Free public ones are used if empty.
# BASE_SEPOLIA_RPC_URL=
# SEPOLIA_RPC_URL=
