# Copy this file to .env and fill it in. Never commit .env.

PORT=5000
# Where the React app runs (allowed to call the API)
CORS_ORIGIN=http://localhost:3000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ── SQL Server ──
DB_SERVER=localhost
# DB_PORT=1433
DB_NAME=voting_v2
DB_USER=sa
DB_PASSWORD=
# true for Azure SQL; false is fine for a local SQL Server
DB_ENCRYPT=false
DB_TRUST_CERT=true

# ── Blockchain ──
# Local Hardhat node (npm run node in the project root)
RPC_URL=http://127.0.0.1:8545
# Account that deployed VotingV2 (owns it). For the local Hardhat node this is account #0:
ADMIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Account that pays gas for votes. Defaults to ADMIN_PRIVATE_KEY if empty. Hardhat account #1:
RELAYER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# Optional: defaults to abi/VotingV2.address.json written by the deploy script
# CONTRACT_ADDRESS=

# ── Tuning ──
MIN_PUBLISH_LEAD_SECONDS=120
VOTER_BATCH_SIZE=100
RELAY_RATE_LIMIT_PER_MINUTE=20
